{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "ask",
      ".opencode/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env*": "deny",
      ".opencode/**": "allow"
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": false
    }
  }
}
